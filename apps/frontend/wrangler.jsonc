{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The WORKER's name. Not the database's — that is `database_name` below.
  "name": "postvyn",
  // A custom entry (src/worker.ts) rather than vinext's bare fetch handler: the cron needs a
  // `scheduled` export, and a trigger without one fails on every invocation. The entry re-exports
  // vinext's fetch handler, so the app itself is unchanged.
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets come from the Vite build. `run_worker_first` routes everything through the Worker
  // except hashed build output, which the asset layer serves directly.
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "postvyn-db",
      "database_id": "fb0beba2-4cc0-46e6-a736-a158387230e2",
      // Per-binding remote proxy (wrangler ≥4, GA — no experimental flag): local dev talks to the
      // DEPLOYED database while the Worker itself still runs in workerd on this machine, so HMR and
      // `.dev.vars` keep working. `remote: false` switches back to the local `.wrangler/` file.
      "remote": true,
      "migrations_dir": "db/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "postvyn-bucket"
    }
  ],

  "vars": {
    "PUBLISHING_ENABLED": "false",
    "R2_PUBLIC_BASE": "",
    // The bucket's own name, which the R2 binding does not expose: presigning a PUT needs it in the
    // URL. Must match `r2_buckets[0].bucket_name` above.
    "R2_BUCKET": "postvyn-bucket"
  },

  // Two schedules, two jobs. Every five minutes: the cadence m4 chose for container polling — a Worker
  // cannot sleep, so "wait for Meta" means "look again on the next tick" (m4 design decision 4). ~15
  // posts a week makes the frequency free, and a missed tick is harmless because the next one claims
  // the same rows.
  //
  // 03:00 daily: the media purge (m6 3.4). `src/worker.ts` matches this string against `HYGIENE_CRON`
  // in `src/db/scheduled.ts` to pick the job, so the two are one value written twice — change both or
  // the sweep never runs.
  "triggers": {
    "crons": ["*/5 * * * *", "0 3 * * *"]
  }

  // Deliberately absent, with a reason:
  //
  // `images` — vinext init adds an IMAGES binding because its template optimises images. This project
  // does no transformation (no sharp, no resvg: neither loads in workerd). A binding nothing calls is
  // pure cost.
}

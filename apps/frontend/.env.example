# Postvyn — environment contract
#
# This file is committed. It lists every variable the app reads, and where its value comes from.
# It contains NO secrets. Real values go in:
#
#   pnpm dev               →  .env.local   (gitignored)
#   pnpm exec wrangler dev →  .dev.vars    (gitignored) — dotenv format; values with spaces must be quoted
#
# Generate a secret:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#                     openssl rand -base64 32
#
# Rule: never paste a secret into chat, an issue, or a commit. Write it to the file and say "it's filled".

# ─────────────────────────────────────────────────────────────────────────────
# 1. Required to boot (M1)
# ─────────────────────────────────────────────────────────────────────────────

# Session signing key for Better Auth. Rotating it signs everyone out — that is its only cost.
BETTER_AUTH_SECRET=

# The app's public origin, used for auth callbacks and emailed links.
#   local:  http://localhost:3000
#   prod:   https://studio.<your-domain>
BETTER_AUTH_URL=

# 32 bytes, base64. Encrypts every platform token at rest (AES-256-GCM, ADR-011).
# THIS IS THE ONE KEY THAT CANNOT BE CASUALLY ROTATED: losing it turns every channel into
# reauth_required, because the ciphertext in channel_credentials becomes unreadable.
# Rotation is a re-encrypt pass guarded by channel_credentials.key_version — not a find-and-replace.
TOKEN_ENCRYPTION_KEY=

# Which key that is. New rows are stamped with it; a rotation pass rewrites older rows and bumps
# this. Optional: absent means 1. Never reuse a version number for different key bytes.
TOKEN_ENCRYPTION_KEY_VERSION=1

# ─────────────────────────────────────────────────────────────────────────────
# 2. Email — verification + password reset (M1)
# ─────────────────────────────────────────────────────────────────────────────

# Resend dashboard. Free tier: 3,000/month, 100/day hard cap, no overage.
RESEND_API_KEY=

# Must be on a domain verified in Resend, with SPF + DKIM + DMARC published.
# The subdomain is deliberate: transactional mail never shares a reputation with your main domain.
EMAIL_FROM="Postvyn <no-reply@mail.example.dev>"

# ─────────────────────────────────────────────────────────────────────────────
# 3. Bot defence on signup / reset (M1)
# ─────────────────────────────────────────────────────────────────────────────

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 4. Operations
# ─────────────────────────────────────────────────────────────────────────────

# Global publishing kill switch (ADR-019). `false` stops new claims; already-queued jobs stay
# queued and resume when it flips back. Ship with `false` and turn it on deliberately.
PUBLISHING_ENABLED=false

# Shared secret the Cron Trigger handler checks before claiming jobs (M4).
CRON_SECRET=

# Base URL that R2 objects are served from, e.g. https://media.<your-domain>
# A plain var in wrangler.jsonc, not a secret.
R2_PUBLIC_BASE=

# ─────────────────────────────────────────────────────────────────────────────
# 5. NOT IN THIS FILE — social media credentials belong in the database
# ─────────────────────────────────────────────────────────────────────────────
#
# Instagram, Threads and X credentials are NOT environment variables. You enter them in the app
# (M1/M5 onboarding), they are encrypted with TOKEN_ENCRYPTION_KEY, and they live in
# `channel_credentials` — one row per channel, so one user can hold many accounts per platform.
#
# Why not env: env holds one value per key. This product is one user → many brands → many channels,
# and each channel needs its own token. Env cannot express that; a table can.
#
# What you will paste into the UI (never here):
#
#   Instagram   app id + app secret + long-lived access token + IG business account id
#   Threads     app id + app secret + access token + threads user id
#   X           API key + API secret + access token + access secret   (OAuth 1.0a — 4 values)
#   TikTok      NOTHING — automated upload is refused by their ToS; ships via the in-app scheduler
#
# Secrets at rest: ciphertext + nonce + tag in their own row, with the channel id bound as
# additional authenticated data, so a database dump cannot move a token from one channel to another.

# ─────────────────────────────────────────────────────────────────────────────
# 6. Deployment only — never read by the running app
# ─────────────────────────────────────────────────────────────────────────────

# Used by wrangler on this machine and by GitHub Actions. Not available inside the Worker.
CLOUDFLARE_ACCOUNT_ID=

# Scoped token: Workers Scripts:Edit + D1:Edit. Never the Global API Key.
# CI only — do not put this in .dev.vars.
CLOUDFLARE_API_TOKEN=

# S3-compatible credentials for R2. Needed ONLY by offline scripts (importer, backup export).
# The Worker itself uses the R2 binding declared in wrangler.jsonc, not these.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 7. Bindings — declared in wrangler.jsonc, not environment variables
# ─────────────────────────────────────────────────────────────────────────────
#
#   DB     D1 database  (database_id)      every query, through src/db only
#   MEDIA  R2 bucket    (bucket_name)      uploaded media the platforms fetch
#   crons  Cron Trigger                    job claiming (M4)
#
# Bindings arrive as `env` in the Worker signature. They are not strings you can set here, and
# local `wrangler dev` serves a file-backed D1 plus a local R2 stand-in automatically.
